# Copia este archivo a back/.env y rellénalo.

# Turso: `turso db create inversiones`, `turso db show inversiones --url`
# y `turso db tokens create inversiones`. Sin estas dos variables se usa
# un SQLite local en back/data/local.db.
TURSO_DATABASE_URL=libsql://inversiones-TU_USUARIO.turso.io
TURSO_AUTH_TOKEN=

# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
# (tipo "Aplicación web"). Orígenes de JavaScript autorizados:
#   http://localhost:5173  (desarrollo)   http://localhost:3001  (npm start)
GOOGLE_CLIENT_ID=

# openssl rand -hex 32
SESSION_SECRET=

# Cotizaciones en vivo (Yahoo Finance, no oficial). LIVE_QUOTES=0 las desactiva.
# LIVE_QUOTES=1
# Logotipos de los valores (se descargan una vez y se guardan). LOGOS=0 los desactiva.
# LOGOS=1

PORT=3001
HOST=127.0.0.1
# TRUST_PROXY=1   # si va detrás de un proxy HTTPS

# Vigilancia de alertas con la app cerrada: cada cuántos minutos (0 = desactivada).
# ALERT_SWEEP_MIN=5
# Avisos al dispositivo (Web Push). Las claves se generan solas; PUSH=0 los desactiva.
# PUSH_SUBJECT debe ser un contacto real (mailto: o https:) si publicas la app.
# PUSH_SUBJECT=mailto:tu@correo.com
# CSP=0   # desactiva la política de contenido si algo externo deja de cargar
