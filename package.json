{
  "name": "inversiones",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix back && npm install --prefix front",
    "dev:back": "npm run dev --prefix back",
    "dev:front": "npm run dev --prefix front",
    "build": "npm run build --prefix front",
    "start": "npm run start --prefix back",
    "test": "npm test --prefix back && node --test front/test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc -p .",
    "check": "npm run lint && npm run types && npm test && npm run build",
    "e2e": "playwright test",
    "e2e:visual:base": "VISUAL=1 playwright test visual --update-snapshots",
    "e2e:visual": "VISUAL=1 playwright test visual"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
