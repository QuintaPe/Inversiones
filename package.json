{
  "name": "inversiones",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix back && npm install --prefix front",
    "dev:back": "npm run dev --prefix back",
    "dev:front": "npm run dev --prefix front",
    "build": "npm run build --prefix front",
    "start": "npm run start --prefix back",
    "test": "npm test --prefix back && node --test front/test/*.test.js",
    "e2e": "playwright test",
    "e2e:visual:base": "VISUAL=1 playwright test visual --update-snapshots",
    "e2e:visual": "VISUAL=1 playwright test visual"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
